# LoyalPay local credentials template
# Copy this file to `.env` and fill real values.

# Docker infrastructure
SQL_SA_PASSWORD=CHANGE_ME_SQL_PASSWORD
RABBITMQ_USER=CHANGE_ME_RABBIT_USER
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD

# Service runtime values
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ISSUER=LoyalPay
JWT_AUDIENCE=LoyalPayUsers
RABBITMQ_HOST=localhost

# Optional explicit connection strings for service runs
AUTH_DB=Server=localhost,1433;Database=LoyalPayAuthDb;User Id=sa;Password=CHANGE_ME_SQL_PASSWORD;TrustServerCertificate=True;
WALLET_DB=Server=localhost,1433;Database=LoyalPayWalletDb;User Id=sa;Password=CHANGE_ME_SQL_PASSWORD;TrustServerCertificate=True;
REWARDS_DB=Server=localhost,1433;Database=LoyalPayRewardsDb;User Id=sa;Password=CHANGE_ME_SQL_PASSWORD;TrustServerCertificate=True;
