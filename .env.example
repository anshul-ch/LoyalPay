# ─────────────────────────────────────────────────────────────────────────────
# LoyalPay — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server
SQL_SA_PASSWORD=your_sql_password_here
AUTH_DB=Server=localhost,1433;Database=LoyalPayAuthDb;User Id=sa;Password=your_sql_password_here;TrustServerCertificate=true;
WALLET_DB=Server=localhost,1433;Database=LoyalPayWalletDb;User Id=sa;Password=your_sql_password_here;TrustServerCertificate=true;
REWARDS_DB=Server=localhost,1433;Database=LoyalPayRewardsDb;User Id=sa;Password=your_sql_password_here;TrustServerCertificate=true;

# JWT — use a random string of at least 32 characters
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_ISSUER=LoyalPay
JWT_AUDIENCE=LoyalPayUsers

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=loyalpay
RABBITMQ_PASS=your_rabbitmq_password_here
